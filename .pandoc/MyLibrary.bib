@article{amentaFailuresEntrepreneurialState2022,
  title = {The {{Failures}} of the {{Entrepreneurial State}}: {{Subsidies}} to {{Renewable Energies}} in {{Europe}}},
  shorttitle = {The {{Failures}} of the {{Entrepreneurial State}}},
  author = {Amenta, Carlo and Stagnaro, Carlo},
