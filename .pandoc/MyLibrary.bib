  title = {Surface Changes in the {{North Atlantic}} Meridional Overturning Circulation during the Last Millennium},
  author = {Wanamaker, Alan D. and Butler, Paul G. and Scourse, James D. and Heinemeier, Jan and Eiríksson, Jón and Knudsen, Karen Luise and Richardson, Christopher A.},
