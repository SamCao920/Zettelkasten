  author = {McCormick, Michael and Büntgen, Ulf and Cane, Mark A. and Cook, Edward R. and Harper, Kyle and Huybers, Peter John and Litt, Thomas and Manning, Sturt W. and Mayewski, Paul Andrew and More, Alexander Frederick Medico and Nicolussi, Kurt and Tegel, Willy},
  date = {2012},
