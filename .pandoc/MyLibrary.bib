  author = {Dawson, Joseph},
  date = {1696},
  publisher = {John Everingham},
  langid = {english},
  pagetotal = {76},
  keywords = {1st,Unquoted},
  annotation = {This is a 1696 trial of six pirates who served under Captain Henry Avery, a notorious and brutal figure of the Golden Age of Piracy. Through the testimony, one can find the egalitarian practices that characterized pirate governance, includin shared plunder and collective decision-making. This source helped me understand that even in their brutality, incorporated democratic principles that contrasted sharply with the rigid hierarchies of contemporary European societies.}
