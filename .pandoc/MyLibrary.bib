@book{chevrierImplementationLegallyBinding2006,
  title = {The {{Implementation}} of {{Legally Binding Measures}} to {{Strengthen}} the {{Biological}} and {{Toxin Weapons Convention}}: {{Proceedings}} of the {{NATO Advanced Study Institute}}, Held in {{Budapest}}, {{Hungary}}, 2001},
