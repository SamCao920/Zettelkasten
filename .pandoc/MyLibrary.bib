  shorttitle = {Climate {{Endgame}}},
  author = {Kemp, Luke and Xu, Chi and Depledge, Joanna and Ebi, Kristie L. and Gibbins, Goodwin and Kohler, Timothy A. and Rockström, Johan and Scheffer, Marten and Schellnhuber, Hans Joachim and Steffen, Will and Lenton, Timothy M.},
  date = {2022-08-23},
