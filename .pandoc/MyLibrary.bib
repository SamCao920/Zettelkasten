@article{fredrickPiracyResistanceCaribbean2022,
  title = {Piracy as Resistance in the Caribbean and the Pacific},
  author = {Fredrick, Sharonah Esther},
  date = {2022-12-01},
  doi = {10.4324/9780367347093-RERW56-1},
  url = {https://www.taylorfrancis.com/entries/10.4324/9780367347093-RERW56-1/piracy-resistance-caribbean-pacific-sharonah-fredrick-kristen-poole-sharonah-fredrick},
  urldate = {2025-03-30},
  abstract = {The history of piracy in the Americas, and its controversial connections to social marginalisation and political rebellion, demonstrate the contradictions between the positive image of New World piracy among socially-oriented historians and the uniformly negative impression of piracy conveyed by imperial Spanish, English and French chronicles during the sixteenth through eighteenth centuries. Colonisation of the New World did not necessarily guarantee the ascendance of anyone of European background in the Americas, where Old World class prejudices died hard, and where those earlier class prejudices fused with the New World issues of racial exploitation, slavery, and religious persecution in an explosive and increasingly complex brew. The specific role of gender and the phenomenon of female pirate captains and crew is analysed from the standpoint of political and anti-colonial insurgency, and the need to undo the erasure of women from official histories; since the ‘witch-hunting’ scares of Europe’s early modern period, no women had been as hated and feared as these female buccaneers. Ethnic, racial, and religious persecutions during the sixteenth through eighteenth centuries, originating in Europe and transplanted to the Americas, are viewed in conjunction with the concept of pirate societies as a refuge for those shunned by the official sectors in the colonial societies of the Americas. This necessitates a de-criminalisation of the piratical subject, as many of the most prominent members of the pirate societies of the Americas had not consciously sought any outlaw context; rather, their religious affiliations (Huguenot French, Sephardic Jewish, Irish Catholic), their colour, or ethnicity or class, thrust them into piracy by default, more often as an act of economic survival than by initial ideological orientation. Finally, clarification of the differences between ‘privateering’ and ‘piracy’ is described so as to better comprehend categories of ‘lawful’ and ‘unlawful’ maritime warfare during the early modern period in the Americas. There, shifting imperial alliances left gaping economic marginality that could be filled more efficiently by piracy than by the officially installed matrix of financial opportunity in a world of maritime violence – hence, the explosion of piracy.},
  langid = {english},
  keywords = {2nd,Resource},
  annotation = {This chapter is an examination of the history of piracy in the Americas and its connection to political revolt and social marginalization. The author explores ethnic, racial, and religious persecution and the concept of pirate societies as refuge for the marginalized. The article also clarifies the difference between privateering and piracy and the motivations for New World piracy, e.g., economic survival and resistance to colonial powers.}
}

