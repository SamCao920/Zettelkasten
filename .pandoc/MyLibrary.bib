@article{NewsViewsSchool2002,
  title = {News and {{Views}}: {{School Vouchers}}; {{An Educational Conundrum}} for {{Black America}}},
  shorttitle = {An {{Educational Conundrum}} for {{Black America}}},
  date = {2002-21},
  journaltitle = {The Journal of Blacks in Higher Education},
  number = {35},
  pages = {79},
  publisher = {BruCon Publishing Company},
  location = {New York, United States},
  issn = {10773711},
  url = {https://www.proquest.com/docview/195564083/abstract/BD9208A8222C4AD9PQ/1},
  urldate = {2025-01-29},
  abstract = {Black parents in general are much more open to the idea of school voucher programs. A poll by Public Agenda, a New York City-based research organization concerned with education issues, found that 68 percent of all African Americans were strongly or somewhat in favor of school vouchers. This was considerably higher than support for school vouchers among whites. A poll by the Joint Center for Political Studies, a Washington, D.C., think tank specializing in political issues in the black community, found 60 percent support for school vouchers among African Americans. For blacks ages 25 to 34, 76 percent of all respondents supported school vouchers. More than 70 percent of blacks with school-age children supported vouchers. A new joint study by Mathematica, a nonprofit research organization, and Harvard University shows that black students participating in a privately funded voucher program in three American cities have seen their test scores rise significantly. The study was conducted with 4,000 students in New York City, Washington, D.C., and Dayton, Ohio. Between 1997 and 2000, black students who attended parochial or private schools in these cities under the voucher program scored nine percentage points higher on standardized math and reading tests than black students who remained in the public schools. Proponents of school vouchers were quick to advance this study as evidence that a nationwide school voucher program would boost overall black student test scores.},
  langid = {english},
  pagetotal = {0}
}

