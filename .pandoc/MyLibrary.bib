  shorttitle = {The {{Paris Agreement}} and {{Key Actors}}’ {{Domestic Climate Policy Mixes}}},
  author = {Skjærseth, Jon Birger and Andresen, Steinar and Bang, Guri and Heggelund, Gørild M.},
  date = {2021},
  journaltitle = {International Environmental Agreements},
  shortjournal = {Int. Environ. Agreem.},
  volume = {21},
  number = {1},
  eprint = {33619430},
