  author = {Wolf, Patrick J. and Kisida, Brian and Gutmann, Babette and Puma, Michael and Eissa, Nada and Rizzo, Lou},
  date = {2013},
  journaltitle = {Journal of Policy Analysis and Management},
  volume = {32},
  number = {2},
  eprint = {42001528},
