@article{delpontePayYourDebts2022,
  title = {Pay {{Your Debts}}: {{Moral Dilemmas}} of {{International Debt}}},
  shorttitle = {Pay {{Your Debts}}},
  author = {Del Ponte, Alessandro and DeScioli, Peter},
  date = {2022},
  journaltitle = {Political Behavior},
  shortjournal = {Political Behav.},
  volume = {44},
  number = {4},
  eprint = {33432251},
  eprinttype = {pubmed},
  pages = {1657--1680},
  issn = {0190-9320},
  doi = {10.1007/s11109-020-09675-6},
  abstract = {Should a government repay its international debts even if this imposes severe hardships on its citizens? Drawing on moral psychology, we investigate when people think a government is morally obligated to pay its debts. Participants read about a government that has to decide whether to default on its debt payments or cut vital programs. Across conditions, we varied the number of jobs at stake and whether a full or partial default is required to save them. Overall, most participants judged that a government should pay its debt even when the damage to the debtor is greater than the benefit to the lender. As the damage to the debtor became extreme, participants increasingly said the government should default, but they still judged that defaulting is morally wrong. In Experiment 2, we find in a national sample of Americans that political conservatives were more opposed to default than liberals. We discuss implications for policy, public opinion, and public welfare during economic downturns. SUPPLEMENTARY INFORMATION: The online version of this article (10.1007/s11109-020-09675-6) contains supplementary material, which is available to authorized users.},
  langid = {english},
  pmcid = {PMC7787656},
  keywords = {Resource},
  file = {C:\Users\samca\Zotero\storage\LTTNAWHS\Del Ponte and DeScioli - 2022 - Pay your debts moral dilemmas of international debt.pdf}
}

@thesis{denglerPiratesLifeMe2022,
  type = {thesis},
  title = {A {{Pirate}}'s {{Life}} for {{Me}}: {{How Caribbean Pirates Developed}} an {{Egalitarian Order}} to {{Pursue}} a {{Life}} of {{Freedom}} and {{Indulgence}} in the 18th {{Century Atlantic World}}},
  shorttitle = {A {{Pirate}}'s {{Life}} for {{Me}}},
  author = {Dengler, Matthew P.},
  date = {2022-11-10},
  institution = {Middlebury},
  url = {https://middlebury.figshare.com/articles/thesis/A_Pirate_s_Life_For_Me_How_Caribbean_Pirates_Developed_an_Egalitarian_Order_to_Pursue_a_Life_of_Freedom_and_Indulgence_in_the_18th_Century_Atlantic_World/21537744/1},
  urldate = {2025-01-07},
  abstract = {This thesis combines both theories to suggest that pirates created their egalitarian systems out of both a practical necessity to ensure order and an ideological aversion to despotism. The first section provides readers a window into the history of Caribbean piracy in order to contextualize the egalitarian systems they created. The second analyzes the composition of a typical pirate crew, specifically focusing on how its diverse makeup and aversion to the authoritarianism on naval and merchant vessels both required a more democratic form of governance to maintain order. The final section utilizes the research of political scientist Joseph Heath about successful egalitarian systems to illustrate that pirates created, regulated and applied their unique political order to best provide for a hedonistic lifestyle of pleasure and freedom that they collectively valued. It illustrates the fact that these egalitarian forms of governance provided pirates with alternative to the harsh authoritarian systems they had withdrawn from. Instead of living according to the rules of their time which they detested, pirates simply wrote their own, freely embracing their impulses instead of repressing them. While this sometimes resulted in horrific acts of rape, murder or larceny, it also fostered the creation of one of the most unique and progressive forms of government in the 18th century.},
  langid = {english},
  keywords = {2nd,Resource},
  annotation = {This thesis explores the egalitarian nature of pirate societies, investigating the daily life of pirate communities and drawing on primary source testimony to understand the motivation and behavior of pirates. Highlighting the egalitarian nature of Caribbean pirate societies, the author argues that pirates developed a unique social order to pursue freedom and equality. I used quotes from this source to both highlight the motivation for piracy and their egalitarian institutions.},
  file = {C:\Users\samca\Zotero\storage\A25Q7K39\Dengler - 2022 - A Pirate's Life For Me How Caribbean Pirates Developed an Egalitarian Order to Pursue a Life of Fre.pdf}
}

