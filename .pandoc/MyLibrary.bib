@article{gertMinimalismsContinuedCreep2023,
  title = {Minimalism's Continued Creep: {{Subject}} Matter},
  shorttitle = {Minimalism's Continued Creep},
  author = {Gert, Joshua},
  date = {2023-10-17},
  journaltitle = {Analytic Philosophy},
  shortjournal = {Philosophical Books},
  pages = {phib.12324},
  issn = {2153-9596, 2153-960X},
  doi = {10.1111/phib.12324},
  url = {https://onlinelibrary.wiley.com/doi/10.1111/phib.12324},
  urldate = {2024-07-25},
  abstract = {Abstract                            The problem of creeping minimalism is the problem of drawing a principled distinction between expressivists and non‐expressivists.               Explanationism               is a popular strategy for solving the problem, but two of its forms—ontological explanationism and representational explanationism—have fatal problems. Christine Tiefensee and Matthew Simpson have recently, and independently, endorsed a third form: subject matter explanationism. But this form also fails. At bottom, the problem is that it does not note the existence of non‐reductive expressivist views, just as earlier forms of explanationism did not note the existence of error theories, or non‐naturalist realists, or realists who wanted to endorse deflationary views of truth and representation. The failure of this latest version of explanationism—one that does indeed avoid problems with earlier versions—strengthens the case that we may not actually want a solution to the problem of creeping minimalism after all. Rather, a form of global expressivism—neopragmatism—might be regarded as yielding a version of non‐naturalist normative realism.},
  langid = {english},
  file = {C:\Users\samca\Zotero\storage\8XY3W6JZ\Gert - 2023 - Minimalism's continued creep Subject matter.pdf}
}

