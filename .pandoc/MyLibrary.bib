}

@article{wangEndingEraPopulation2016,
  title = {Ending an {{Era}} of {{Population Control}} in {{China}}: {{Was}} the {{One-Child Policy Ever Needed}}?},
  shorttitle = {Ending an {{Era}} of {{Population Control}} in {{China}}},
  author = {Wang, Zhihe and Yang, Ming and Zhang, Jiaming and Chang, Jiang},
  date = {2016},
  journaltitle = {The American Journal of Economics and Sociology},
  volume = {75},
  number = {4},
