@book{howlettMeritocracyItsDiscontents2021,
  title = {Meritocracy and Its Discontents: Anxiety and the National College Entrance Exam in {{China}}},
  shorttitle = {Meritocracy and Its Discontents},
  author = {Howlett, Zachary M.},
  date = {2021},
  publisher = {Cornell University Press},
  location = {Ithaca},
