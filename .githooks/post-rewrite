#!/bin/sh
# Runs automatically after every `git pull --rebase` (our configured sync mode).
# Cleans up *-SamsComputer* conflict copies and machine-specific junk files.
VAULT="$(git rev-parse --show-toplevel)"
python3 "$VAULT/vault-auto-clean.py" 2>/dev/null || python "$VAULT/vault-auto-clean.py" 2>/dev/null || true
