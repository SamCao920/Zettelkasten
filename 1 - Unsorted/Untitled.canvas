	"nodes":[
		{"id":"c1ec33f9dbc992ee","type":"group","x":-740,"y":240,"width":1520,"height":620,"label":"Special Conception of Justice"},
		{
			"id":"0e0dd3768d14af7d",
			"type":"text",
			"text":"**Justice as Fairness**",
			"styleAttributes":{"textAlign":"center","shape":"database"},
			"x":-140,
			"y":-280,
			"width":260,
			"height":80
		},
		{
			"id":"2cf390a0b1d99e5b",
			"type":"text",
			"text":"Original Position",
			"styleAttributes":{"textAlign":"center"},
			"x":-340,
			"y":-100,
			"width":260,
			"height":60
		},
		{
			"id":"497e9b3850f6f841",
			"type":"text",
			"text":"Reflective Equilibrium",
			"styleAttributes":{},
			"x":60,
			"y":-100,
			"width":260,
			"height":60
		},
		{
			"id":"3012beef1f6a9afe",
			"type":"text",
			"text":"Veil of Ignorance",
			"styleAttributes":{"shape":"diamond","textAlign":"center"},
			"x":-520,
			"y":60,
			"width":260,
			"height":60
		},
		{
			"id":"50aef1036d29405a",
			"type":"text",
			"text":"General Conception of Justice",
			"styleAttributes":{},
			"x":-160,
			"y":90,
			"width":300,
			"height":60
		},
		{
			"id":"a6315476e0a795e2",
			"type":"text",
			"text":"1. [[Each person has equal basic rights most extensively compatible with similar liberties for others]]",
			"styleAttributes":{},
			"x":-420,
			"y":280,
			"width":380,
			"height":120
		},
		{
			"id":"af599a1d27f41287",
			"type":"text",
			"text":"2. Difference principle",
			"styleAttributes":{},
			"x":20,
			"y":310,
			"width":380,
			"height":60
		},
		{
			"id":"3683158729defc2a",
			"type":"text",
			"text":"[[The difference principle expresses fraternity]]",
			"styleAttributes":{"shape":"pill"},
			"x":240,
			"y":460,
			"width":260,
			"height":100
		},
		{
			"id":"58abc07553474885",
			"type":"text",
			"text":"[[The difference principle expresses reciprocity]]",
			"styleAttributes":{"shape":"pill"},
			"x":-50,
			"y":460,
			"width":260,
			"height":100
		},
		{
			"id":"504970ff348f8eee",
			"type":"text",
			"text":"[[The difference principle has definite advantages over utilitarianism]]",
			"styleAttributes":{"shape":"pill"},
			"x":500,
			"y":320,
			"width":260,
			"height":120
		},
		{
			"id":"4948bd13dbb83c3b",
			"type":"text",
			"text":"[[The difference principle embodies the idea that natural contingencies are commonly shared between members of a society]]",
			"styleAttributes":{"shape":"pill"},
			"x":20,
			"y":600,
			"width":420,
			"height":120
		},
		{
			"id":"4139f92a2b8f7100",
			"type":"text",
			"text":"[[Liberty can only be restricted in order to protect or strengthen the overall system of equal basic liberties]]",
			"styleAttributes":{"shape":"pill"},
			"x":-450,
			"y":510,
			"width":370,
			"height":130
		},
		{
			"id":"bd3db00c43ab8aff",
			"type":"text",
			"text":"[[Rational agents would be risk-averse in the original position]]",
			"styleAttributes":{"shape":"pill"},
			"x":-710,
			"y":-100,
			"width":260,
			"height":120
		}
	],
