{
	"nodes":[
		{"id":"c1ec33f9dbc992ee","type":"group","x":-940,"y":200,"width":2160,"height":680,"label":"Special Conception of Justice"},
		{
			"id":"0e0dd3768d14af7d",
			"type":"text",
			"text":"**Justice as Fairness**",
			"styleAttributes":{"textAlign":"center","shape":"database"},
			"x":-140,
			"y":-280,
			"width":260,
			"height":80
		},
		{
			"id":"2cf390a0b1d99e5b",
			"type":"text",
			"text":"Original Position",
			"styleAttributes":{"textAlign":"center"},
			"x":-340,
			"y":-100,
			"width":260,
			"height":60
		},
		{
			"id":"497e9b3850f6f841",
			"type":"text",
			"text":"[[Rawls' Reflective Equilibrium.canvas]]",
			"styleAttributes":{},
			"x":60,
			"y":-100,
			"width":380,
			"height":60
		},
		{
			"id":"af599a1d27f41287",
			"type":"text",
			"text":"2. Difference principle and Fair Equality of Opportunity",
			"styleAttributes":{},
			"x":20,
			"y":310,
			"width":380,
			"height":70
		},
		{
			"id":"504970ff348f8eee",
			"type":"text",
			"text":"[[The difference principle has definite advantages over utilitarianism]]",
			"styleAttributes":{"shape":"pill"},
			"x":500,
			"y":320,
			"width":260,
			"height":120
		},
		{
			"id":"50aef1036d29405a",
			"type":"text",
			"text":"General Conception of Justice",
			"styleAttributes":{},
			"x":-160,
			"y":90,
			"width":300,
			"height":60
		},
		{
			"id":"4064d72c43251c07",
			"type":"text",
			"text":"[[We should accept the methodological approach of the original position, even though it is hypothetical]]",
			"styleAttributes":{"shape":"pill"},
			"x":-555,
			"y":-320,
			"width":290,
			"height":160
		},
		{
			"id":"4948bd13dbb83c3b",
			"type":"text",
			"text":"[[The difference principle embodies the idea that natural contingencies are commonly shared between members of a society]]",
			"styleAttributes":{"shape":"pill"},
			"x":20,
			"y":600,
			"width":420,
			"height":120
		},
		{
			"id":"a6315476e0a795e2",
			"type":"text",
			"text":"1. [[Each person has equal basic rights most extensively compatible with similar liberties for others]]",
			"styleAttributes":{},
			"x":-605,
			"y":280,
			"width":380,
			"height":120
		},
		{
			"id":"4139f92a2b8f7100",
			"type":"text",
			"text":"[[Liberty can only be restricted in order to protect or strengthen the overall system of equal basic liberties]]",
			"styleAttributes":{"shape":"pill"},
			"x":-450,
			"y":470,
			"width":370,
			"height":130
		},
		{
			"id":"fa9d643273580efe",
			"type":"text",
			"text":"[[Justice as fairness fosters self-respect and societal harmony]]",
			"styleAttributes":{"shape":"pill"},
			"x":250,
			"y":-240,
			"width":400,
			"height":80
		},
		{
			"id":"c0dd8165ffb9053c",
			"type":"text",
			"text":"[[Justice as fairness would be accepted by free, rational, and prudential persons]]",
			"styleAttributes":{"shape":"pill"},
			"x":240,
			"y":-350,
			"width":400,
			"height":60
		},
		{
			"id":"07922202d8f7e7a8",
			"type":"text",
			"text":"[[Justice as fairness is specifically designed for a closed, well-ordered society]]",
			"styleAttributes":{"shape":"pill"},
			"x":-30,
			"y":-460,
			"width":400,
			"height":80
		},
		{
			"id":"53d7fc900be863a8",
			"type":"text",
			"text":"[[Justice as fairness does not apply to individual dealings with specific people, only to institutions]]",
			"styleAttributes":{"shape":"pill"},
			"x":-480,
			"y":-460,
			"width":380,
			"height":100
		},
		{
			"id":"49f33e06e3bf0faf",
			"type":"text",
			"text":"[[Justice has lexical priority over other societal concerns]]",
			"styleAttributes":{"shape":"pill"},
			"x":210,
			"y":85,
			"width":320,
			"height":70
		},
		{
			"id":"8cf260f0088736e5",
			"type":"text",
			"text":"[[A principle must satisfy generality, universality, publicity, ordering, and finality in order to be a candidate principle in the original position]]",
			"styleAttributes":{"shape":"pill"},
			"x":-920,
			"y":-200,
			"width":365,
			"height":160
		},
		{
			"id":"bd3db00c43ab8aff",
			"type":"text",
			"text":"[[Rational agents would be risk-averse in the original position]]",
			"styleAttributes":{"shape":"pill"},
			"x":-815,
			"y":0,
			"width":260,
			"height":120
		},
		{
			"id":"3012beef1f6a9afe",
			"type":"text",
			"text":"Veil of Ignorance",
			"styleAttributes":{"shape":"diamond","textAlign":"center"},
			"x":-450,
			"y":30,
			"width":260,
			"height":60
		},
		{
			"id":"3683158729defc2a",
			"type":"text",
			"text":"[[The difference principle expresses fraternity]]",
			"styleAttributes":{"shape":"pill"},
			"x":240,
			"y":485,
			"width":260,
			"height":100
		},
		{
			"id":"58abc07553474885",
			"type":"text",
			"text":"[[The difference principle expresses reciprocity]]",
			"styleAttributes":{"shape":"pill"},
			"x":-50,
			"y":485,
			"width":260,
			"height":100
		},
		{
			"id":"0e826638a1956c75",
			"type":"text",
			"text":"[[Fair equality of opportunity is lexically before the difference principle]]",
			"styleAttributes":{"shape":"pill"},
			"x":530,
			"y":545,
			"width":370,
			"height":80
		},
		{
			"id":"3aa05bc853fa2fbd",
			"type":"text",
			"text":"[[Fair equality of opportunity is a precondition for pure procedural justice]]",
			"styleAttributes":{"shape":"pill"},
			"x":800,
			"y":420,
			"width":280,
			"height":100
		},
		{
			"id":"396826e21f134e36",
			"type":"text",
			"text":"[[Social and economic inequalities are to satisfy the Difference Principle and Fair Equality of Opportunity]]",
			"styleAttributes":{"shape":"pill"},
			"x":400,
			"y":220,
			"width":520,
			"height":80
		}
	],
