views:
  - type: cards
    name: Table
    filters:
      or:
        - file.folder == "2 - Source Material/2.a - Books"
        - file.folder == "2 - Source Material/2.d - Short Stories & Poems"
    order:
      - file.name
      - tags
      - author
    sort:
      - property: file.mtime
        direction: DESC
    image: note.cover
    imageAspectRatio: 1
    cardSize: 200
